---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
  label?: string;
}

const { href, variant = 'primary', external = false, label } = Astro.props;
---

<a
  class:list={['button', variant === 'secondary' && 'button--secondary']}
  href={href}
  aria-label={label}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
</a>
