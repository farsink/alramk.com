---
import { nav, contact } from '../data/site';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="utility">
    <div class="utility__inner">
      <span class="utility__tag">
        <Icon name="horse" size={20} />
        Endurance race management · {contact.location}
      </span>
      <div class="utility__contact">
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <span aria-hidden="true">·</span>
        <a href={`tel:${contact.phoneHref}`}>{contact.phone}</a>
      </div>
    </div>
  </div>

  <div class="masthead">
    <div class="container masthead__inner">
      <a class="brand" href="/" aria-label="Al-Ramk home">
        <img src="/brand/al-ramk-icon.png" width="42" height="42" alt="" />
        <span class="brand__word">Al-Ramk</span>
      </a>

      <nav class="primary-nav" aria-label="Primary">
        {nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>

      <div class="masthead__actions">
        <a class="button masthead__cta" href="/contact/">Request a Demo</a>

        <details class="mobile-menu">
          <summary aria-label="Navigation menu">
            <span class="mobile-menu__bars" aria-hidden="true">
              <span></span><span></span><span></span>
            </span>
          </summary>
          <div class="mobile-menu__panel">
            <nav aria-label="Mobile">
              {nav.map((item) => (
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </nav>
            <div class="mobile-menu__contact">
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
              <a href={`tel:${contact.phoneHref}`}>{contact.phone}</a>
            </div>
            <a class="button" href="/contact/">Request a Demo</a>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
  }

  .utility {
    color: #f3ede4;
    background: linear-gradient(104deg, #241e19 0 63%, #c79c65 63% 100%);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }
  .utility__inner {
    display: flex;
    width: min(100% - 80px, 1320px);
    min-height: 40px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-inline: auto;
  }
  .utility__tag {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #f3ede4;
    font-weight: 500;
  }
  .utility__tag svg { color: #c79c65; }
  .utility__contact {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #241e19;
    font-weight: 600;
  }
  .utility__contact a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .masthead {
    border-bottom: 1px solid rgba(74, 63, 53, 0.18);
    background: #f3ede4;
    transition: box-shadow 0.3s ease, background 0.3s ease;
  }
  .masthead__inner {
    display: flex;
    min-height: 84px;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    flex: 0 0 auto;
  }
  .brand img {
    width: 42px;
    height: 42px;
    border: 1px solid rgba(74, 63, 53, 0.16);
    border-radius: 4px;
    background: #fff;
    object-fit: cover;
  }
  .brand__word {
    color: #4a3f35;
    font-family: 'Cinzel Variable', serif;
    font-size: 1.65rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.4vw, 34px);
  }
  .primary-nav a {
    position: relative;
    padding: 32px 0;
    color: #4a3f35;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .primary-nav a::after {
    position: absolute;
    right: 0;
    bottom: 24px;
    left: 0;
    height: 1px;
    background: #8a6a34;
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s var(--ease);
  }
  .primary-nav a:hover::after,
  .primary-nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .masthead__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .masthead__cta {
    min-height: 48px;
    padding: 12px 22px;
    background: #c79c65;
    border-color: #c79c65;
    color: #241e19;
  }
  .masthead__cta::after {
    border-bottom-color: #241e19;
  }

  .mobile-menu {
    display: none;
    position: relative;
  }
  .mobile-menu summary {
    display: grid;
    width: 50px;
    height: 50px;
    place-items: center;
    background: #241e19;
    list-style: none;
    cursor: pointer;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu__bars {
    display: grid;
    gap: 5px;
    width: 20px;
  }
  .mobile-menu__bars span {
    display: block;
    height: 1px;
    background: #f3ede4;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .mobile-menu[open] .mobile-menu__bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .mobile-menu[open] .mobile-menu__bars span:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu[open] .mobile-menu__bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  .mobile-menu__panel {
    position: absolute;
    top: calc(100% + 13px);
    right: 0;
    width: min(88vw, 360px);
    padding: 18px;
    border: 1px solid rgba(74, 63, 53, 0.18);
    background: #f3ede4;
    box-shadow: 0 26px 60px rgba(36, 30, 25, 0.18);
  }
  .mobile-menu__panel nav {
    display: grid;
    border-top: 1px solid rgba(74, 63, 53, 0.18);
  }
  .mobile-menu__panel nav a {
    display: flex;
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(74, 63, 53, 0.18);
    color: #4a3f35;
    font-family: 'Cinzel Variable', serif;
    font-size: 1.1rem;
  }
  .mobile-menu__panel nav a span {
    color: #8a6a34;
    font-family: 'DM Sans Variable', sans-serif;
    font-size: 0.9rem;
  }
  .mobile-menu__contact {
    display: grid;
    gap: 4px;
    padding: 18px 0;
    color: #5e5751;
    font-size: 0.84rem;
  }
  .mobile-menu__panel .button {
    width: 100%;
  }

  @media (max-width: 1120px) {
    .primary-nav {
      gap: 15px;
    }
    .primary-nav a {
      font-size: 0.7rem;
    }
  }

  @media (max-width: 980px) {
    .utility {
      background: #241e19;
    }
    .utility__inner {
      width: min(100% - 40px, 1200px);
      justify-content: center;
      min-height: 36px;
    }
    .utility__contact {
      display: none;
    }
    .masthead__inner {
      min-height: 72px;
    }
    .primary-nav,
    .masthead__cta {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .brand__word {
      font-size: 1.4rem;
    }
  }

  @media (max-width: 480px) {
    .utility__tag {
      font-size: 0.68rem;
    }
    .brand img {
      width: 38px;
      height: 38px;
    }
  }
</style>
