---
const S = 0.07;
const H = 1.1;
---
<html>
  <body>
    <svg viewBox="0 0 1000 620">
      <path id="cm-loop-1" d="M 500 500 A 170 170 0 0 1 500 160 A 170 170 0 0 1 500 500" fill="none" stroke="#985A2C" />
      <path id="cm-loop-2" d="M 500 500 A 116 116 0 0 1 500 268 A 116 116 0 0 1 500 500" fill="none" stroke="#9C9246" />
      <path id="cm-loop-3" d="M 500 500 A 90 90 0 0 1 500 320 A 90 90 0 0 1 500 500" fill="none" stroke="#4A3F35" />
      <g id="cm-hold" opacity="0"><rect x="394" y="206" width="212" height="30" /><text x="500" y="226">1</text></g>
      <circle id="cm-hold-pulse" cx="500" cy="500" r="14" fill="none" />
      <g id="cm-rider"><circle r="13" /><g transform="translate(-10,-10) scale(0.83)"><path d="M5 21v-4c0-3 2-5 5-6l1-3 2-2 2 2v2l3 2v5h-3l-1 4" d-1="1" /></g></g>
    </svg>
    <pre id="diag">building…</pre>
    <script>
      import gsap from 'gsap';
      import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

      gsap.registerPlugin(MotionPathPlugin);

      const pre = document.getElementById('diag') as HTMLElement;
      const out: Record<string, unknown> = {};
      try {
        const SECONDS_PER_KM = 0.07;
        const HOLD_S = 1.1;
        const rider = document.querySelector('#cm-rider');
        const pulse = document.querySelector('#cm-hold-pulse');
        const holdCallout = document.querySelector('#cm-hold');

        const tl = gsap.timeline({ paused: true, defaults: { ease: 'none' } });
        out.tlType = tl.constructor.name;
        out.vers = gsap.version;

        out.d1 = tl.to({}, { duration: 0.5 }).duration();
        tl.addLabel('start');
        out.d2 = tl.to({}, { duration: 0.5 }).duration();
        tl.addLabel('loop-1');
        const m1 = tl.to(rider, {
          motionPath: { path: '#cm-loop-1', align: '#cm-loop-1', alignOrigin: [0.5, 0.5] } as never,
          duration: 38 * SECONDS_PER_KM,
        });
        out.m1dur = m1.duration();
        out.m1tDur = m1.totalDuration();
        tl.addLabel('hold-1');
        out.h1 = tl.to({}, { duration: HOLD_S }, 'hold-1').duration();
        tl.fromTo(holdCallout, { autoAlpha: 0, y: 6 }, { autoAlpha: 1, y: 0, duration: 0.2 }, 'hold-1+=0.05');
        tl.fromTo(holdCallout, { autoAlpha: 1 }, { autoAlpha: 0, duration: 0.2, immediateRender: false }, 'hold-1+=0.85');
        tl.fromTo(pulse, { attr: { r: 14 }, autoAlpha: 0.85 }, { attr: { r: 30 }, autoAlpha: 0, duration: 0.33, repeat: 2 }, 'hold-1');
        tl.addLabel('loop-2');
        const m2 = tl.to(rider, {
          motionPath: { path: '#cm-loop-2', align: '#cm-loop-2', alignOrigin: [0.5, 0.5] } as never,
          duration: 26 * SECONDS_PER_KM,
        });
        out.m2dur = m2.duration();
        out.tlDur = tl.duration();
        out.labels = tl.labels();
        gsap.set(rider, { x: 500, y: 500 });
        out.transform = (rider as SVGGraphicsElement).getAttribute('transform');
        // live tick check on a sibling instance
        const t3 = gsap.to({ v: 0 }, { v: 10, duration: 0.3, paused: true });
        t3.play();
        const d = new Promise<void>((res) => t3.eventCallback('onComplete', () => res()));
        setTimeout(async () => {
          await d;
          out.t3v = (t3.targets?.() ?? [{}])[0].v ?? 'n/a';
          out.t3progress = tl.progress();
          tl.play('start');
          await new Promise((r) => setTimeout(r, 2600));
          out.progressAfter2s6 = Number(tl.progress().toFixed(4));
          out.timeAfter2s6 = Number(tl.time().toFixed(4));
          pre.textContent = JSON.stringify(out, null, 1);
        }, 350);
      } catch (e) {
        out.err = String(e instanceof Error ? e.message : e);
        pre.textContent = JSON.stringify(out, null, 1);
      }
    </script>
  </body>
</html>
